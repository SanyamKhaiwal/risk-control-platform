    {
      "id": 12,
      "type": "timeseries",
      "title": "Cache hit ratio (Risk Service)",
      "description": "Dashboard queries answered from Redis instead of PostgreSQL. It drops after every risk change, which clears the cache.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(cache_gets_total{job=\"risk-service\",result=\"hit\"}[5m])) / sum(rate(cache_gets_total{job=\"risk-service\"}[5m]))",
          "legendFormat": "hits",
          "refId": "A",
          "range": true,
          "instant": false,
          "exemplar": false
