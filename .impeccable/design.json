  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The main action in a header or form.",
      "html": "<button class=\"ds-btn ds-btn-primary\">Record assessment</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;gap:6px;height:34px;padding:0 14px;border-radius:var(--r,6px);border:1px solid var(--rule-2,#c6cecb);background:var(--sheet,#fff);color:var(--ink,#111917);font:500 0.8125rem 'Geist Variable',system-ui,sans-serif;cursor:pointer;transition:background-color 150ms ease,border-color 150ms ease,color 150ms ease}.ds-btn:hover{background:var(--sheet-2,#f0f3f1)}.ds-btn:active{transform:translateY(0.5px)}.ds-btn:focus-visible{outline:none;box-shadow:0 0 0 3px rgb(29 95 82 / 0.28)}.ds-btn-primary{background:var(--accent,#1d5f52);border-color:var(--accent,#1d5f52);color:#fff}.ds-btn-primary:hover{background:var(--accent-hover,#164a40);border-color:var(--accent-hover,#164a40)}"
    },
