      "html": "<button class=\"ds-btn ds-btn-danger\">Unlink</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;gap:6px;height:34px;padding:0 14px;border-radius:var(--r,6px);border:1px solid var(--rule-2,#c6cecb);background:var(--sheet,#fff);color:var(--ink,#111917);font:500 0.8125rem 'Geist Variable',system-ui,sans-serif;cursor:pointer;transition:background-color 150ms ease,border-color 150ms ease,color 150ms ease}.ds-btn:hover{background:var(--sheet-2,#f0f3f1)}.ds-btn:active{transform:translateY(0.5px)}.ds-btn:focus-visible{outline:none;box-shadow:0 0 0 3px rgb(29 95 82 / 0.28)}.ds-btn-danger{color:var(--red,#b42318);border-color:#e7b9b4}.ds-btn-danger:hover{background:var(--red-wash,#fbeae8)}"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Field with label above.",
      "html": "<label class=\"ds-field\"><span class=\"ds-label\">Title</span><input class=\"ds-input\" placeholder=\"Risk title\"></label>",
      "css": ".ds-field{display:grid;gap:6px;font-family:'Geist Variable',system-ui,sans-serif}.ds-label{font-size:0.8125rem;font-weight:500;color:var(--ink-2,#44504c)}.ds-input{min-height:34px;padding:6px 10px;border:1px solid var(--rule-2,#c6cecb);border-radius:6px;background:#fff;font:inherit;font-size:0.8125rem;transition:border-color 150ms ease,box-shadow 150ms ease}.ds-input:hover{border-color:var(--ink-3,#5f6b67)}.ds-input:focus{outline:none;border-color:var(--accent,#1d5f52);box-shadow:0 0 0 3px rgb(29 95 82 / 0.28)}"
    },
    {
      "name": "Rating Badges",
      "kind": "chip",
      "refersTo": "badge-rating-high",
      "description": "Rating wash always with word and score.",
      "html": "<span class=\"ds-badge ds-low\">Low 4</span> <span class=\"ds-badge ds-med\">Medium 9</span> <span class=\"ds-badge ds-high\">High 15</span> <span class=\"ds-badge ds-crit\">Critical 20</span>",
      "css": ".ds-badge{display:inline-flex;align-items:center;gap:6px;height:22px;padding:0 8px;border-radius:11px;font:500 0.75rem 'Geist Variable',system-ui,sans-serif;font-variant-numeric:tabular-nums}.ds-low{background:#e3f0e8;color:#1d5638}.ds-med{background:#f6efd6;color:#664c08}.ds-high{background:#fae2d2;color:#863710}.ds-crit{background:#f5d3cf;color:#8b1a12}"
    },
    {
      "name": "Top Navigation",
      "kind": "nav",
      "refersTo": "topbar",
      "description": "Sticky white bar; current item underlined in accent; red re-test count.",
      "html": "<nav class=\"ds-nav\"><a aria-current=\"page\">Overview</a><a>Register</a><a>Controls</a><a>Re-test <span class=\"ds-count\">3</span></a></nav>",
      "css": ".ds-nav{display:flex;height:56px;gap:4px;background:#fff;border-bottom:1px solid var(--rule,#e0e5e2);font:500 0.875rem 'Geist Variable',system-ui,sans-serif}.ds-nav a{position:relative;display:flex;align-items:center;gap:6px;padding:0 12px;color:var(--ink-3,#5f6b67);cursor:pointer;transition:color 150ms ease}.ds-nav a:hover,.ds-nav a[aria-current=page]{color:var(--ink,#111917)}.ds-nav a[aria-current=page]::after{content:'';position:absolute;left:12px;right:12px;bottom:-1px;height:2px;border-radius:2px 2px 0 0;background:var(--accent,#1d5f52)}.ds-count{min-width:18px;height:18px;padding:0 5px;border-radius:9px;background:var(--red,#b42318);color:#fff;font-size:11px;font-weight:600;line-height:18px;text-align:center}"
    },
    {
      "name": "Sheet",
      "kind": "card",
      "refersTo": "sheet",
      "description": "Ruled white section; no shadow.",
      "html": "<section class=\"ds-sheet\"><div class=\"ds-sheet-head\"><div><h2>Highest residual risks</h2><p>Top 10 by residual score</p></div></div><div class=\"ds-sheet-body\">Ruled content</div></section>",
      "css": ".ds-sheet{background:#fff;border:1px solid var(--rule,#e0e5e2);border-radius:8px;font-family:'Geist Variable',system-ui,sans-serif;font-size:0.875rem}.ds-sheet-head{min-height:52px;padding:12px 16px;border-bottom:1px solid var(--rule,#e0e5e2);display:flex;align-items:center}.ds-sheet-head h2{margin:0;font-size:1rem;font-weight:600}.ds-sheet-head p{margin:2px 0 0;font-size:0.8125rem;color:var(--ink-3,#5f6b67)}.ds-sheet-body{padding:16px}"
    },
    {
      "name": "Posted Figure",
      "kind": "custom",
      "refersTo": "posted",
      "description": "Signature motion: old figure struck in red, new figure posted beside it.",
      "html": "<span class=\"ds-posted\"><s class=\"ds-was\">16</s><span class=\"ds-now\">9</span></span>",
      "css": ".ds-posted{display:inline-flex;align-items:baseline;gap:0.4em;font:600 1.75rem 'Geist Variable',system-ui,sans-serif;letter-spacing:-0.02em;font-variant-numeric:tabular-nums}.ds-was{position:relative;text-decoration:none;color:#5f6b67;animation:ds-leave 360ms ease 1700ms forwards}.ds-was::after{content:'';position:absolute;left:-0.12em;right:-0.12em;top:55%;height:max(1.5px,0.09em);background:#b42318;transform:scaleX(0);transform-origin:left center;animation:ds-strike 280ms cubic-bezier(0.16,1,0.3,1) forwards}.ds-now{display:inline-block;animation:ds-in 360ms cubic-bezier(0.16,1,0.3,1) 220ms both}@keyframes ds-strike{to{transform:scaleX(1)}}@keyframes ds-in{from{opacity:0;transform:translateY(0.3em);filter:blur(2px)}to{opacity:1;transform:none;filter:none}}@keyframes ds-leave{to{opacity:0}}"
    },
    {
      "name": "Segmented Control",
      "kind": "custom",
      "refersTo": "segmented-selected",
      "description": "Radio group for likelihood/impact 1-5; selected is solid ink.",
      "html": "<div class=\"ds-seg\" role=\"radiogroup\"><button>1</button><button>2</button><button aria-checked=\"true\">3</button><button>4</button><button>5</button></div>",
      "css": ".ds-seg{display:inline-flex;gap:2px;padding:2px;border:1px solid var(--rule-2,#c6cecb);border-radius:6px;background:#fff}.ds-seg button{min-width:34px;height:28px;padding:0 10px;border:0;border-radius:4px;background:transparent;color:var(--ink-2,#44504c);font:500 0.8125rem 'Geist Variable',system-ui,sans-serif;font-variant-numeric:tabular-nums;cursor:pointer;transition:background-color 150ms ease,color 150ms ease}.ds-seg button:hover{background:var(--sheet-2,#f0f3f1);color:var(--ink,#111917)}.ds-seg button[aria-checked=true]{background:var(--ink,#111917);color:#fff}.ds-seg button:focus-visible{outline:none;box-shadow:0 0 0 3px rgb(29 95 82 / 0.28)}"
