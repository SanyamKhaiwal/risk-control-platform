# Copy to .env (git-ignored) and change the values. Read by Docker Compose and by the services' `local` profile.
# These are dev-only settings; never reuse them anywhere else.

# --- PostgreSQL (Risk Service) ---
DB_URL=jdbc:postgresql://localhost:5432/riskdb
DB_USER=risk
DB_PASSWORD=change-me

# --- MongoDB (Control Service) ---
# Authentication is on: "admin" is root (used by the container healthcheck), "control" can only read and write
# controldb. Both users are created on first start. From the host, connect directly to the single member.
MONGO_ADMIN_PASSWORD=change-me
MONGO_PASSWORD=change-me
MONGO_URI=mongodb://control:${MONGO_PASSWORD}@localhost:27017/controldb?directConnection=true&authSource=admin

# --- Kafka / Redis ---
KAFKA_BOOTSTRAP=localhost:9092
REDIS_HOST=localhost
REDIS_PASSWORD=change-me

# --- Service URLs ---
RISK_SERVICE_URL=http://localhost:8081
CONTROL_SERVICE_URL=http://localhost:8082

# --- JWT (RS256). Generate the dev key pair with: node scripts/gen-dev-keys.mjs ---
JWT_PRIVATE_KEY_PATH=deploy/keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=deploy/keys/jwt-public.pem
# Kafka events are signed (Ed25519); each service has its own signing key and the other's public key. The defaults
# point at deploy/keys/events-*.pem, so these only need setting to use other paths.
# EVENTS_SIGNING_KEY_PATH=
# EVENTS_PEER_PUBLIC_KEY_PATH=

# --- Gateway ---
# Browser origins allowed to call the API (comma-separated). Demo users are defined in
# gateway/src/main/resources/application.yml (password for all: demo123).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Monitoring (Grafana at http://localhost:3000; anyone can view, the admin can change dashboards) ---
GRAFANA_ADMIN_PASSWORD=change-me
# Share of requests traced (1.0 = all). Lower it for load tests.
TRACING_SAMPLE_RATE=1.0

# --- Dashboard ---
VITE_API_URL=http://localhost:8080
